# Copy to .env.local. Validated in src/lib/env.ts.

# Leave unset locally to use file-backed PGlite (.data/pglite).
# On Vercel this is set by the Neon integration.
DATABASE_URL=

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
